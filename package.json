{
  "name": "bos-bot",
  "private": true,
  "bosUpdatePolicy": {
    "mode": "offline"
  },
  "version": "2.2.0",
  "description": "Open-source, local-first AI workspace for people and bots, with desktop and mobile clients.",
  "homepage": "https://github.com/ferazfhansurie/bos-bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferazfhansurie/bos-bot.git"
  },
  "author": {
    "name": "BOS Bot",
    "email": "bos@aihlete.com"
  },
  "bosUpstream": {
    "name": "OpenMausBot",
    "author": "Milind Soni",
    "license": "Apache-2.0"
  },
  "license": "Apache-2.0",
  "desktopName": "ai.bos.bot.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "docs:dev": "pnpm --filter @bosbot/docs dev",
    "docs:build": "pnpm --filter @bosbot/docs build",
    "docs:preview": "pnpm --filter @bosbot/docs preview",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "omb": "node --experimental-strip-types server/bosbot.ts",
    "pair": "node --experimental-strip-types server/bosbot.ts pair",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:omb": "node --experimental-strip-types scripts/control-omb.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm broker:test && pnpm test:electron && pnpm test:packaged-server",
    "test:electron": "node --test \"electron/*.node-test.mjs\"",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "gen:bodies": "node --experimental-strip-types scripts/gen-mascot-bodies.ts",
    "gen:glyphs": "node --experimental-strip-types scripts/gen-glyph-faces.ts",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p tsconfig.companion.build.json && node scripts/bundle-companion.mjs",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:notch": "node electron/build-notch-helper.mjs",
    "build:smart-ui": "node scripts/build-smart-ui-embed.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:cua:win": "node scripts/prepare-cua-win.mjs",
    "smoke:cua-win": "node scripts/smoke-cua-win-embedded.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "smoke:browser": "node scripts/smoke-browser-bundle.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build:adblock && pnpm build && pnpm build:server && pnpm build:companion && pnpm build:updater && pnpm build:android-tools && pnpm build:cloudflared && pnpm build:browser",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:notch && pnpm build:cua && node scripts/release-contract.mjs package staging mac",
    "package:win": "pnpm package:prepare && pnpm build:cua:win && node scripts/release-contract.mjs package staging win",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && node scripts/release-contract.mjs package staging linux",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --config electron-builder.staging.yml --linux --x64 --publish never",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-update": "xvfb-run -a electron --no-sandbox scripts/smoke-linux-update.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --config electron-builder.staging.yml --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "broker:types": "wrangler types --config cloudflare/composio-broker/wrangler.jsonc cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config cloudflare/composio-broker/wrangler.jsonc",
    "control-plane:types": "pnpm --filter @bosbot/control-plane types",
    "control-plane:check": "pnpm --filter @bosbot/control-plane check",
    "control-plane:test": "pnpm --filter @bosbot/control-plane test",
    "control-plane:dry-run": "pnpm --filter @bosbot/control-plane dry-run",
    "package:mac:live": "node scripts/release-contract.mjs check live mac && pnpm package:prepare && pnpm build:speech && pnpm build:notch && pnpm build:cua && node scripts/release-contract.mjs package live mac",
    "package:win:live": "node scripts/release-contract.mjs check live win && pnpm package:prepare && pnpm build:cua:win && node scripts/release-contract.mjs package live win",
    "package:linux:live": "node scripts/release-contract.mjs check live linux && pnpm package:prepare && pnpm build:cua:linux && node scripts/release-contract.mjs package live linux",
    "test:release-contract": "node --test scripts/release-contract.test.mjs scripts/release-stage.test.mjs",
    "test:scripts": "node --test scripts/bos-readiness.test.mjs scripts/enterprise-export-bot.test.mjs scripts/linux-package-contract.test.mjs scripts/release-contract.test.mjs scripts/release-stage.test.mjs",
    "build:adblock": "node scripts/prepare-adblock.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@ghostery/adblocker": "^2.20.1",
    "@hpke/core": "1.9.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@trycua/cua-driver": "0.28.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "docx": "^9.11.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.539.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "node-pty": "1.1.0",
    "posthog-js": "^1.415.6",
    "qrcode-terminal": "0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "whatsapp-web.js": "1.34.7",
    "ws": "8.18.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "oxlint": "1.80.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "bugs": {
    "url": "https://github.com/ferazfhansurie/bos-bot/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "electron",
    "local-first",
    "claude",
    "codex"
  ]
}
