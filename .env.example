# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=bosbot
BOS_BIND_ADDRESS=127.0.0.1
BOS_HTTP_PORT=8080
# Leave empty to use http://localhost:${BOS_HTTP_PORT:-8080}.
BOS_PUBLIC_URL=
# Leave empty to inherit BOS_PUBLIC_URL.
BOS_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set BOS_PUBLIC_URL to https:// followed by the same hostname.
# Requires BOS_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
BOS_HTTPS_HOST=
BOS_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
BOS_LOCAL_IMAGE=bosbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
BOS_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
BOS_DATA_EXTERNAL=false
