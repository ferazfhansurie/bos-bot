{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bosbot-control-plane",
  "main": "src/index.ts",
  "account_id": "c61ebef98ce08261f656ff078b7af231",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "accounts.bosbot.my",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://accounts.bosbot.my",
    "EMAIL_FROM": "noreply@bosbot.my",
    "ALLOWED_ORIGINS": "",
    "CLOUDFLARE_ACCOUNT_ID": "c61ebef98ce08261f656ff078b7af231",
    "CLOUDFLARE_ZONE_ID": "cdf09f9f7fd20124e9cd7f967144d1e2",
    "COMPANION_HOST_SUFFIX": "bosbot.my"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CLOUDFLARE_API_TOKEN", "RESEND_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bosbot-control-plane",
      "database_id": "a5dbe0dd-67fd-484f-b8e7-661e5b833e2a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
// branding compatibility (electron/branding-compat.json): data-home: existing desktop and companion homes, backups and lease recovery must open the same data; deployed-services: existing worker databases, service health identities and hosted addresses must not become a different service
