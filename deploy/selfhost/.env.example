# Copy to .env (0600). Generate passwords with openssl rand -hex 24.
# Use hex passwords to avoid URL escaping. Never print the resolved compose config.
DOMAIN=bos.example.invalid
POSTGRES_PASSWORD=
ISSUER_DB_PASSWORD=
CLOUD_APP_PASSWORD=
BETTER_AUTH_SECRET=
# openssl rand -base64 32; keep this across upgrades.
CLOUD_SERVICE_KEY=
ISSUER_ALLOWED_EMAILS=
ISSUER_ALLOWED_EMAIL_DOMAINS=
# Pilot log delivery needs an operator to relay each code. SMTP enables self-serve OTP.
ISSUER_OTP_DELIVERY=log
ISSUER_SMTP_URL=
ISSUER_EMAIL_FROM=
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
RELEASE_TAG=local
