<?xml version="1.0" encoding="utf-8"?>
<!--
  Companion traffic is plain HTTP on a trusted network (LAN) or over Tailscale
  WireGuard (*.ts.net / CGNAT 100.64/10). Domain config cannot express raw IP
  allowlists, and Tailscale CGNAT addresses look like public internet to the
  platform — so cleartext is permitted at the base config. Product policy:
  LAN-is-trusted-only. Hosted routes use certificate-validated HTTPS; permitting
  cleartext here does not make a local route an automatic credential fallback.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
