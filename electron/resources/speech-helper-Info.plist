<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDisplayName</key>
    <string>BOS Bot</string>
    <key>CFBundleExecutable</key>
    <string>speech-helper</string>
    <key>CFBundleIdentifier</key>
    <string>com.openmausbot.app.speech-helper</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>BOS Bot Speech</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSBackgroundOnly</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>BOS Bot listens while you dictate messages or talk to a bot.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>BOS Bot converts your speech into text during dictation and calls.</string>
  </dict>
</plist>
<!-- branding compatibility (electron/branding-compat.json): data-home: existing desktop and companion homes, backups and lease recovery must open the same data; native-helper-id: existing OS permission identity of the native control and speech helpers stays the same -->
